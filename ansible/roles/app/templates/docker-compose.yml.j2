
services:
    # 1. Base de datos MySQL (Solo accesible dentro de la red interna)
    db: 
        image: mysql:8.0 
        container_name: wp_db 
        restart: unless-stopped 
        environment: 
            MYSQL_ROOT_PASSWORD: "{{ db_root_password }}" 
            MYSQL_DATABASE: "{{ db_name }}" 
            MYSQL_USER: "{{ db_user }}" 
            MYSQL_PASSWORD: "{{ db_user_password }}" 
        volumes: 
            - db_data:/var/lib/mysql 
        networks: 
            - internal_net

    # 2. Aplicación WordPress (Expuesta al exterior)
    wordpress:
        image: wordpress:latest
        container_name: wp_app
        restart: unless-stopped
        depends_on:
            - db
        environment:
            WORDPRESS_DB_HOST: db:3306
            WORDPRESS_DB_NAME: "{{ db_name }}"
            WORDPRESS_DB_USER: "{{ db_user }}"
            WORDPRESS_DB_PASSWORD: "{{ db_user_password }}"
        volumes:
            - wp_data:/var/www/html
        networks:
            - internal_net

    # 3. Gestor de base de datos (phpMyAdmin)
    phpmyadmin:
        image: phpmyadmin:latest
        container_name: wp_phpmyadmin
        restart: unless-stopped
        depends_on:
            - db
        environment:
            PMA_HOST: db
            PMA_PORT: 3306
            PMA_ABSOLUTE_URI: "http://{{ domain_name }}/phpmyadmin/"
        networks:
            - internal_net

    # 4. Proxy inverso (Nginx) para exponer la aplicación al exterior
    nginx:
        image: nginx:alpine
        container_name: wp_nginx
        restart: unless-stopped
        depends_on:
            - wordpress
            - phpmyadmin
        ports:
            - "80:80"
            - "443:443"
        volumes:
            - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
            - wp_data:/var/www/html:ro
        networks:
            - internal_net
    
    # Volumenes para garantizar que los datos persistan incluso si el servidor se reinicia

volumes:
    db_data:
    wp_data:

# Red privada para la comunicación entre los contenedores
networks:
    internal_net:
        driver: bridge